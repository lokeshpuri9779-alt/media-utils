      "confirmed_at": "2026-10-24T10:27:21.975551+00:00",
      "title": "The Stone-Mason of Oakhaven and the Pact of the Sunken Well",
      "plot_fingerprint": "38348dc79256ab11ae74bb553cf14a38f51c044331a30115ed150df3b2f11484",
      "story_beats": [
        {
          "speech": "Look closely at the foundation stones, Elara, the earth is shifting beneath our feet and the main well is bleeding away."
        },
        {
          "speech": "If we do not seal this chamber now, the entire village will sink into the abyss by tomorrow's first golden dawn light."
        },
        {
          "speech": "We have shared every secret here for twenty years, but today we must break our sanctuary to protect the lives of others."
        },
        {
          "speech": "The dust has finally settled, our water is gone, but the village stands firm and the people are safe for another hundred years."
        }
      ]
    },
    {
      "content_id": "rayvan-gemini-ecb1cea03ea48b9a46e0",
      "video_id": "bjWomHn1K2E",
