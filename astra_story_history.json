      "story_beats": [
        {
          "speech": "We cannot risk a complete engine failure over a minor pressure spike in sector four."
        },
        {
          "speech": "Waiting will drain our reserve power completely before we even reach the outer asteroid belt."
        },
        {
          "speech": "Let us run the secondary diagnostic sequence to isolate the exact pressure fault safely."
        },
        {
          "speech": "The valve is secured at last, and our main engines are running at optimal stability."
